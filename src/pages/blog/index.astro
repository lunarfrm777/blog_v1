---
import Layout from "../../layouts/Layout.astro";

interface Post {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: string;
  };
  file: string;
}

const postModules = import.meta.glob<Post>("../posts/*.md", { eager: true });

const sortedPosts = Object.entries(postModules)
  .map(([path, post]) => ({
    ...post,
    slug: path.split("/").pop()?.replace(".md", ""),
  }))
  .sort(
    (a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf()
  );
---
<Layout centerNav={false}>
    <div class="blog-list">
      <h1>Blog Posts</h1>
      <ul>
        {sortedPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`}>
              <h2>{post.frontmatter.title}</h2>
              {post.frontmatter.description && <p>{post.frontmatter.description}</p>}
            </a>
          </li>
        ))}
      </ul>
    </div>
</Layout>


<style>
  .blog-list {
    max-width: 700px;
    margin: 3rem auto;
    padding: 0 1.5rem;
  }
  .blog-list h1 {
    text-align: center;
    color: rgb(75, 5, 52);
    margin-bottom: 2rem;
  }
  .blog-list ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .blog-list li a {
    display: block;
    text-decoration: none;
    background: linear-gradient(135deg, #fff0f6, #ffe4f1);
    border: 2px solid #ffb6d9;
    border-radius: 1.2rem;
    padding: 1.2rem 1.5rem;
    box-shadow: 0 0 12px rgba(255, 130, 190, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-list li a:hover {
    transform: scale(1.02);
    box-shadow: 0 0 20px rgba(255, 130, 190, 0.45);
  }
  .blog-list h2 {
    margin: 0 0 0.4rem 0;
    color: rgb(75, 5, 52);
  }
  .blog-list p {
    margin: 0;
    color: rgb(120, 60, 95);
    font-size: 0.95rem;
  }
</style>
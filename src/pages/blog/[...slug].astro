---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const postFiles = Object.values(
    import.meta.glob("../posts/*.md", { eager: true })
  ) as any[];

  return postFiles.map((post) => {
    const filename = post.file.split("/").pop()?.replace(".md", "");
    return {
      params: { slug: filename },
      props: { post },
    };
  });
}

const { post } = Astro.props as { post: any };
const { Content } = post;
---
<Layout>
  <article class="post">
    <h1>{post.frontmatter.title}</h1>
    {post.frontmatter.pubDate && (
      <p class="post-date">{new Date(post.frontmatter.pubDate).toLocaleDateString()}</p>
    )}
    {post.frontmatter.description && (
      <p class="post-description">{post.frontmatter.description}</p>
    )}
    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 700px;
    margin: 3rem auto;
    padding: 2rem;
    background: linear-gradient(135deg, #fff0f6, #ffe4f1);
    border: 2px solid #ffb6d9;
    border-radius: 1.5rem;
    box-shadow: 0 0 20px rgba(255, 130, 190, 0.3);
  }
  .post h1 {
    color: rgb(75, 5, 52);
    margin-bottom: 0.5rem;
  }
  .post-date {
    color: rgb(150, 100, 130);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .post-description {
    color: rgb(120, 60, 95);
    font-style: italic;
    margin-bottom: 1.5rem;
  }
  .post-content {
    color: rgb(75, 5, 52);
    line-height: 1.7;
  }
  .post-content :global(h2) {
    color: rgb(120, 30, 80);
    margin-top: 1.5rem;
  }
  .post-content :global(a) {
    color: #ff4fa3;
  }
  .post-content :global(p) {
    margin-bottom: 1rem;
  }
</style>
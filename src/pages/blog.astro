---
import Layout from "../layouts/Layout.astro";

// src/pages/Blog.astro (or wherever this lives)
const posts = Object.values(
  import.meta.glob('./posts/*.md', { eager: true })
);
---
<Layout>
    <ul>
    {posts.map(post => (
        <li>
        <a href={post.url}>{post.frontmatter.title}</a>
        </li>
    ))}
    </ul>
</Layout>
---
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---
<div class:list={["container", "menu", "menu-horizontal", "rounded-box", { small }]}>
  <a href="/">Home</a>
  <!-- <a href="/about">About</a> -->
  <a href="/blog">Blog Posts</a>
</div>

<style>
  .container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.2rem 2.5rem;
    background: linear-gradient(135deg, #fff0f6, #ffe4f1);
    border: 2px solid #ffb6d9;
    box-shadow: 0 0 20px rgba(255, 130, 190, 0.4);
    border-radius: 999px;
    font-size: 1rem;
  }

  .container.small {
    padding: 0.6rem 1.4rem;
    gap: 0.7rem;
    font-size: 0.85rem;
  }

  a {
    text-decoration: none;
    color: rgb(75, 5, 52);
    font-weight: bold;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  a:hover {
    color: #ff4fa3;
    transform: scale(1.1);
  }
</style>

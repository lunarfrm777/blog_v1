---
import Nav from "../components/Nav.astro"
import PageWrapper from "../components/PageWrapper.astro"

interface Props {
  centerNav?: boolean;
}
const { centerNav = true } = Astro.props;
const isHome = Astro.url.pathname === "/";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Lune's Blog</title>
	</head>
	<body>
		<div class="sparkle-field">
			<span class="sparkle" style="top: 10%; left: 15%;">✨</span>
			<span class="sparkle" style="top: 20%; left: 80%;">💖</span>
			<span class="sparkle" style="top: 70%; left: 10%;">⭐</span>
			<span class="sparkle" style="top: 80%; left: 85%;">✨</span>
			<span class="sparkle" style="top: 15%; left: 50%;">💫</span>
			<span class="sparkle" style="top: 85%; left: 45%;">💕</span>
			<span class="sparkle" style="top: 45%; left: 5%;">⭐</span>
			<span class="sparkle" style="top: 50%; left: 92%;">✨</span>
		</div>

		<PageWrapper center={isHome} top={!isHome}>
			<Nav />
		</PageWrapper>
		<slot />
	</body>
</html>
<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #FCBBDC;
	}

	<style is:global>
	.sparkle-field {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: -1;
	}

	.sparkle {
		position: absolute;
		font-size: 1.5rem;
		animation: twinkle 2.5s ease-in-out infinite;
		filter: drop-shadow(0 0 4px rgba(255, 105, 180, 0.6));
	}

	.sparkle:nth-child(odd) {
		animation-duration: 3.2s;
		animation-delay: 0.5s;
	}

	.sparkle:nth-child(3n) {
		animation-delay: 1s;
		font-size: 1.2rem;
	}

	@keyframes twinkle {
		0%, 100% {
			opacity: 0.3;
			transform: scale(0.8) rotate(0deg);
		}
		50% {
			opacity: 1;
			transform: scale(1.2) rotate(15deg);
		}
	}
</style>
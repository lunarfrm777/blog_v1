---
import Footer from '../components/Footer.astro';
const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <title>{frontmatter.title}</title>
  </head>
  <body style={`background-color: ${frontmatter.backgroundColor || '#FCBBDC'}`}>
    <main>
      <slot />
      <Footer />
    </main>
  </body>
</html>
 